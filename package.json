{
  "name": "@trapmikhandr/ui",
  "version": "1.0.0",
  "description": "React component library based on React Aria, Vanilla Extract and Material Design 3",
  "author": "trapmikhandr",
  "license": "MIT",
  "keywords": [
    "react",
    "component-library",
    "design-system",
    "react-aria",
    "vanilla-extract",
    "material-design"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "dist/index.d.ts",
  "packageManager": "pnpm@11.10.0",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./dist/ui.css": "./dist/ui.css",
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.mjs",
      "require": "./dist/components/*/index.cjs"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "vite build",
    "analyze": "ANALYZE=1 vite build",
    "dev": "vite build --watch",
    "lint": "biome lint .",
    "lint:fix": "biome lint --fix .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "jest",
    "test:clear": "jest --clearCache",
    "sb": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "pnpm clean && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@storybook/addon-docs": "^9.1.15",
    "@storybook/addon-onboarding": "^9.1.15",
    "@storybook/react": "^9.1.15",
    "@storybook/react-vite": "^9.1.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vanilla-extract/css": "^1.17.4",
    "@vanilla-extract/jest-transform": "^1.1.17",
    "@vanilla-extract/recipes": "^0.5.7",
    "@vanilla-extract/sprinkles": "^1.6.5",
    "@vanilla-extract/vite-plugin": "5.1.1",
    "@vitejs/plugin-react": "^5.1.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.68.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^9.1.15",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tanstack/react-virtual": "^3.14.6",
    "@use-gesture/react": "^10.3.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.548.0",
    "motion": "12.42.2",
    "react-aria": "^3.44.0",
    "react-stately": "^3.42.0"
  }
}
